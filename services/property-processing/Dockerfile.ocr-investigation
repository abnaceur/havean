# Separately admitted release of the exact offline/native/model bytes above.
# Its source and notice bundle is part of the distributable image.
FROM worker-no-gui-investigation AS ocr-release
COPY --from=media-build /opt/media /opt/media
COPY services/property-processing/media-build.json /opt/media/build-profile.json
COPY services/property-processing/ocr-production-release.json /opt/processing/ocr-release.json
COPY services/property-processing/.ocr-sources /usr/share/doc/haven-processing/ocr-sources
COPY assets/digitization-fonts/LICENSE.txt assets/digitization-fonts/manifest.json /usr/share/doc/haven-processing/source-notices/assets/digitization-fonts/
COPY docs/digitization/OCR-PRODUCTION-REVIEW.md /usr/share/doc/haven-processing/OCR-PRODUCTION-REVIEW.md
COPY services/property-processing/verify_ocr_release.py /opt/processing/verify_ocr_release.py
RUN python /opt/processing/verify_ocr_release.py
CMD ["python", "-m", "property_processing.server"]
