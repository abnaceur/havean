{
  "name": "haven-real-estate",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "docker compose up --build",
    "dev:setup": "node scripts/setup.mjs",
    "lint": "eslint . && node scripts/boundaries.mjs",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test --project=visual && playwright test --project=desktop --project=mobile",
    "test:visual": "node scripts/visual-policy.mjs && playwright test --project=visual",
    "task:validate": "node scripts/tasks.mjs",
    "check:release": "node scripts/tasks.mjs --release",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "db:seed": "tsx packages/database/src/seed.ts",
    "license:check": "node scripts/licenses.mjs",
    "contracts:models": "node scripts/generate-models.mjs",
    "contracts:generate": "node scripts/generate-contracts.mjs && tsx scripts/generate-openapi.ts && tsx scripts/generate-digitization-schemas.ts",
    "contracts:check": "node scripts/generate-contracts.mjs --check && tsx scripts/generate-openapi.ts --check && tsx scripts/generate-digitization-schemas.ts --check",
    "fixtures:generate": "tsx scripts/fixtures.ts",
    "fixtures:check": "tsx scripts/fixtures.ts --check",
    "search:rebuild": "tsx scripts/rebuild-search.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "type": "module"
}
