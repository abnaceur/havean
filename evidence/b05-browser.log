HERE id=$1",[listing]);const foreignOrg='10000000-0000-4000-8000-000000000005',unit=(await c.query("INSERT INTO units(community_id,organization_id,area,beds,living_rooms,baths,orientation,floor) SELECT community_id,$1,area,beds,living_rooms,baths,orientation,floor FROM units WHERE id='10000000-0000-4000-8000-000000001000' RETURNING id",[foreignOrg])).rows[0];await c.query("INSERT INTO listings(id,unit_id,organization_id,slug,title,description,transaction,segment,currency,price,status) VALUES($1,$2,$3,$4,$5,'Explicit synthetic other-agency dashboard fixture','sale','residential','CNY','3100000.25','draft')",[foreign,unit.id,foreignOrg,'b05-'+foreign,foreignTitle]);});await page.reload();const d=(await (await page.request.get('/api/v1/ops/agent-dashboard')).json()).data;expect(d.counts).toEqual({inventory:before.counts.inventory+1,published:before.counts.published,newLeads:before.counts.newLeads+1,upcoming:before.counts.upcoming+1});for(const [key,value] of Object.entries(d.counts))await expect(page.locator('[data-metric="'+key+'"]')).toHaveText(String(value));await expect(page.getByRole('heading',{name:'Your assigned work',exact:true})).toBeVisible();await expect(page.getByRole('time')).toHaveAttribute('datetime',d.asOf);expect(JSON.stringify(d)).not.toContain(foreign);expect(JSON.stringify(d)).not.toContain(foreignTitle);await expect(page.locator('main')).not.toContainText(foreignTitle);await expect(page.getByRole('region',{name:'New leads preview',exact:true})).toContainText(client);await expect(page.getByRole('region',{name:'Upcoming appointments preview',exact:true})).toContainText(title);const ownLead=d.newLeads.find((l:any)=>l.id===lead);expect((await apiRequest(page,'/ops/leads/'+lead,{version:ownLead.version,status:'assigned'},'PATCH')).ok()).toBe(true);await page.getByRole('button',{name:'Refresh dashboard',exact:true}).click();await expect(page.locator('[data-metric="newLeads"]')).toHaveText(String(before.counts.newLeads));const axe=await new AxeBuilder({page}).include('main').analyze();expect(axe.violations.filter(v=>v.impact==='serious'||v.impact==='critical')).toEqual([]);expect(await page.evaluate(()=>document.documentElement.scrollWidth<=window.innerWidth)).toBe(true);await page.screenshot({path:`evidence/b05-dashboard-${info.project.name}.png`,scale:'css'});await page.getByRole('link',{name:title,exact:true}).click();await expect(page).toHaveURL(/\/ops\/listings\?q=/);await expect(page.locator('.inventory-workbench')).toContainText(title);await page.goto('http://localhost:8089/ops');await page.route('**/api/v1/ops/agent-dashboard',route=>route.fulfill({status:503,json:{error:{code:'TEMPORARY_UNAVAILABLE',message:'Dashboard source temporarily unavailable'}}}));await page.reload();await expect(page.locator('main').getByRole('alert')).toContainText('Dashboard source temporarily unavailable');await expect(page.locator('[data-metric]')).toHaveCount(0);await page.unroute('**/api/v1/ops/agent-dashboard');await page.getByRole('button',{name:'Try again',exact:false}).click();await expect(page.locator('[data-metric="inventory"]')).toHaveText(String(before.counts.inventory+1));
